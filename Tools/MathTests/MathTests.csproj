<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain .NET harness that compiles the Unity-independent math in Assets/ProjectionFX/Scripts/Math and verifies it.
       Run: dotnet run project Tools/MathTests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/ProjectionFX/Scripts/Math/*.cs" />
  </ItemGroup>
</Project>
