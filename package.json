{
  "name": "projectionfx",
  "version": "1.0.0",
  "description": "Interactive Real-Time Projection Mapping with 3D Gaussian Splatting & MediaPipe Vision",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/test_math.js",
    "electron:dev": "electron .",
    "build:win": "vite build && electron-builder --win --x64 -c.publish=never"
  },
  "dependencies": {
    "three": "^0.170.0",
    "@mediapipe/tasks-vision": "^0.10.18"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.1"
  },
  "build": {
    "appId": "com.stunfazer.projectionfx",
    "productName": "ProjectionFX",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  }
}
